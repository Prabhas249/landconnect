{
  "expo": {
    "name": "LandConnect",
    "slug": "landconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "landconnect",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "si.landconnect.prototype",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      }
    },
    "android": {
      "package": "si.landconnect.prototype",
      "adaptiveIcon": {
        "backgroundColor": "#10201C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10201C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
            "node_modules/@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
            "node_modules/@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/geist/700Bold/Geist_700Bold.ttf",
            "node_modules/@expo-google-fonts/geist-mono/500Medium/GeistMono_500Medium.ttf",
            "node_modules/@expo-google-fonts/geist-mono/700Bold/GeistMono_700Bold.ttf",
            "node_modules/@expo-google-fonts/poppins/600SemiBold/Poppins_600SemiBold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-build-properties",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "LandConnect needs your photos to attach land images to a listing."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LandConnect uses your location to geotag a land parcel."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "LandConnect uses the camera for in-app video calls.",
          "microphonePermission": "LandConnect uses the microphone for in-app calls."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-dev-client",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
